{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@skills/*": ["./skills/*"]
    }
  },
  "include": ["skills/**/*.ts", "agents/**/*.ts", "local/project.ts"]
}
